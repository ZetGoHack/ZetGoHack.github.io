---
import Hero from '../Hero.astro';
import Gallery from '../Gallery.astro';
import { featured } from '../../data/photos';
---

<Hero />

<section class="section section--alt">
  <div class="container">
    <h2 class="section-title">Featured work</h2>
    <!-- TODO: replace placeholder images with real featured photos (src/data/photos.ts) -->
    <Gallery photos={featured} variant="featured" />
    <div class="gallery-cta">
      <a class="button" href="/gallery">View full gallery</a>
    </div>
  </div>
</section>
