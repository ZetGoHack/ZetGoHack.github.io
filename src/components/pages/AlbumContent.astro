---
import Gallery from '../Gallery.astro';
import type { PublicAlbum } from '../../lib/server/public-view';

interface Props {
  album: PublicAlbum;
}

const { album } = Astro.props;
---

<section class="section">
  <div class="container">
    <a class="album-back" href="/gallery">&larr; All albums</a>
    <h1 class="section-title">{album.title}</h1>
    <Gallery photos={album.photos} />
  </div>
</section>
