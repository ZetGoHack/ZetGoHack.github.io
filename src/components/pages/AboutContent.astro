---
import { about, site } from '../../data/site';
---

<section class="section">
  <div class="container about">
    <h1 class="fadeup">About me</h1>
    <!-- TODO: real bio, awards and contact details live in src/data/site.ts -->
    <p class="fadeup">{about.bio}</p>
    <ul class="awards-list fadeup">
      {about.awards.map((award) => <li>{award}</li>)}
    </ul>
    <p class="about-contact fadeup">
      Phone: <span class="phone-number">{site.phone}</span>
      <br />
      {site.handle}
    </p>
  </div>
</section>
