---
import { getContent } from '../../lib/server/content-store';

const { about, site } = await getContent();
---

<section class="section">
  <div class="container about">
    <h1 class="fadeup">About me</h1>
    <p class="fadeup">{about.bio}</p>
    {
      about.awards.filter(Boolean).length > 0 && (
        <ul class="awards-list fadeup">
          {about.awards.filter(Boolean).map((award) => (
            <li>{award}</li>
          ))}
        </ul>
      )
    }
    <p class="about-contact fadeup">
      Phone: <span class="phone-number">{site.phone}</span>
      <br />
      {site.handle}
    </p>
  </div>
</section>
