---
import type { Photo as PhotoData } from '../data/photos';
import Photo from './Photo.astro';

interface Props {
  photos: PhotoData[];
  variant?: 'default' | 'featured';
}

const { photos, variant = 'default' } = Astro.props;
const isFeatured = variant === 'featured';
---

<div class:list={['gallery', { 'gallery--featured': isFeatured }]}>
  {
    photos.map((photo) => (
      <button
        type="button"
        class="gallery-item reveal"
        style={isFeatured ? `--ar: ${(photo.width / photo.height).toFixed(4)}` : undefined}
        data-lightbox-src={photo.src}
        data-lightbox-alt={photo.alt}
      >
        <Photo photo={photo} />
      </button>
    ))
  }
</div>
