---
import type { Photo as PhotoData } from '../data/photos';
import Photo from './Photo.astro';

interface Props {
  photos: PhotoData[];
}

const { photos } = Astro.props;
---

<div class="gallery">
  {
    photos.map((photo) => (
      <button type="button" class="gallery-item reveal" data-lightbox-src={photo.src} data-lightbox-alt={photo.alt}>
        <Photo photo={photo} />
      </button>
    ))
  }
</div>
