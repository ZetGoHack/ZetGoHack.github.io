---
import type { Photo as PhotoData } from '../data/photos';
import Photo from './Photo.astro';

interface Props {
  photos: PhotoData[];
  variant?: 'default' | 'featured';
}

const { photos, variant = 'default' } = Astro.props;
---

<div class:list={['gallery', { 'gallery--featured': variant === 'featured' }]}>
  {
    photos.map((photo) => (
      <div class="gallery-item">
        <Photo photo={photo} />
      </div>
    ))
  }
</div>
