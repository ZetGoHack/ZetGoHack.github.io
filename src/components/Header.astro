---
import { nav, site } from '../data/site';

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
---

<header class="site-header">
  <a class="site-logo" href="/" aria-label={site.brand}>
    <img src={site.logo} alt={site.brand} width="600" height="600" />
  </a>
  <nav class="header-nav" aria-label="Main navigation">
    {
      nav.map((item) => {
        const target = normalize(item.href);
        const isCurrent = currentPath === target;
        return (
          <a class="header-link" href={target} aria-current={isCurrent ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })
    }
  </nav>
  <button class="burger-toggle" aria-label="Toggle menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>
