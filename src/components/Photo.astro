---
import type { Photo } from '../data/photos';

interface Props {
  photo: Photo;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const { photo, loading = 'lazy', fetchpriority, class: className } = Astro.props;
---

<img
  src={photo.src}
  alt={photo.alt}
  width={photo.width}
  height={photo.height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
/>
