---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { theme, themeCss } from '../data/themes';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.tagline } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={site.logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={theme.fontsHref} />
    <style is:inline set:html={themeCss(theme)}></style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
