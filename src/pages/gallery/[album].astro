---
import Base from '../../layouts/Base.astro';
import AlbumContent from '../../components/pages/AlbumContent.astro';
import { site } from '../../data/site';
import { getContent } from '../../lib/server/content-store';
import { findVisibleAlbum } from '../../lib/server/public-view';

const album = findVisibleAlbum(await getContent(), Astro.params.album ?? '');
if (!album) return Astro.rewrite('/404');
---

<Base title={`${album.title} - ${site.name}`}>
  <AlbumContent album={album} />
</Base>
