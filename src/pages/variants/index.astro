---
/**
 * Client-facing overview of the design presets. Standalone page with its own
 * neutral styling so it does not depend on any one theme.
 */
import { themes } from '../../data/themes';
import { picsum } from '../../data/photos';
import { site } from '../../data/site';

const layoutNames: Record<string, string> = {
  fullbleed: 'фото на всю ширину, текст под ним',
  split: 'две колонки: текст + высокое фото',
  grid: 'крупное имя + сетка фотографий',
  centered: 'фото на весь экран, текст по центру',
};

const references = [
  {
    title: 'Editorial',
    sites: [
      { name: 'KT Merry', url: 'https://ktmerry.com' },
      { name: 'Ryan Flynn Photography', url: 'https://ryanflynnphotography.net' },
      { name: 'Nomad Love Stories', url: 'https://nomadlovestories.com' },
    ],
  },
  {
    title: 'Крем',
    sites: [
      { name: 'Anée Atelier', url: 'https://aneeatelier.com' },
      { name: 'Liam & Bee', url: 'https://liamandbee.com' },
      { name: 'Josie Brooks', url: 'https://josiebrooks.com' },
    ],
  },
  {
    title: 'Студия',
    sites: [
      { name: 'Nick Haigh', url: 'https://nickhaighphotography.co.uk' },
      { name: 'Fabio Mirulla', url: 'https://fabiomirulla.com' },
      { name: 'Simon Dewey', url: 'https://simondewey.co.uk' },
    ],
  },
  {
    title: 'Воздушный',
    sites: [
      { name: 'Cody Kurtz Photography', url: 'https://codykurtzphotography.com' },
      { name: 'Claire Byrne Photography', url: 'https://clairebyrnephotography.com' },
      { name: 'Juno Photo & Film', url: 'https://junophotofilm.com' },
    ],
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Варианты оформления — {site.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href={site.logo} />
    {themes.map((t) => <link rel="stylesheet" href={t.fontsHref} />)}
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f4f4f2;
        color: #1c1c1c;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.55;
      }
      .wrap {
        width: min(1100px, 92%);
        margin: 0 auto;
        padding: 4rem 0 6rem;
      }
      h1 {
        font-size: 2rem;
        margin: 0 0 0.5rem;
      }
      .lead {
        color: #555;
        max-width: 60ch;
        margin: 0 0 3rem;
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
      }
      .card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #e3e3df;
        border-radius: 10px;
        overflow: hidden;
        color: inherit;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      }
      .preview {
        position: relative;
        height: 190px;
        display: flex;
        align-items: flex-end;
        padding: 1.2rem;
        background-size: cover;
        background-position: center;
      }
      .preview span {
        font-size: 2rem;
        line-height: 1;
        padding: 0.4rem 0.8rem;
      }
      .body {
        padding: 1.2rem 1.4rem 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }
      .name {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0;
      }
      .desc {
        color: #444;
        font-size: 0.95rem;
        margin: 0;
        flex: 1;
      }
      .meta {
        font-size: 0.8rem;
        color: #777;
      }
      .swatches {
        display: flex;
        gap: 6px;
      }
      .swatches i {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 1px solid rgba(0, 0, 0, 0.12);
      }
      .cta {
        font-size: 0.9rem;
        font-weight: 600;
        color: #1c1c1c;
      }
      h2 {
        font-size: 1.3rem;
        margin: 4rem 0 1rem;
      }
      .refs {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.5rem;
      }
      .refs h3 {
        font-size: 0.95rem;
        margin: 0 0 0.4rem;
      }
      .refs ul {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.9rem;
      }
      .refs a {
        color: #2a5db0;
      }
      .note {
        margin-top: 3rem;
        padding: 1rem 1.2rem;
        background: #fff8e6;
        border: 1px solid #f0dfae;
        border-radius: 8px;
        font-size: 0.9rem;
        color: #5a4a1a;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>Варианты оформления сайта</h1>
      <p class="lead">
        Пять направлений для сайта {site.name}: четыре светлых и текущее тёмное для сравнения. Каждый вариант — это полностью
        рабочий сайт (главная, «обо мне», цены, галерея). Откройте любой и переключайтесь между ними нижней панелью.
      </p>

      <div class="cards">
        {
          themes.map((t) => (
            <a class="card" href={`/variants/${t.id}`}>
              <div
                class="preview"
                style={`background-image: linear-gradient(${t.vars['--overlay']}, ${t.vars['--overlay']}), url('${picsum(t.heroPhoto.id, 800, 400, { grayscale: t.grayscale })}')`}
              >
                <span
                  style={`font-family:${t.vars['--font-heading']}; font-weight:${t.vars['--heading-weight']}; text-transform:${t.vars['--heading-transform']}; color:${t.vars['--fg']}; background:${t.vars['--bg']}; border-radius:${t.vars['--radius']}`}
                >
                  Andrey Soyka
                </span>
              </div>
              <div class="body">
                <p class="name">{t.name}</p>
                <p class="desc">{t.description}</p>
                <div class="swatches" aria-label="Палитра">
                  <i style={`background:${t.vars['--bg']}`} title="фон" />
                  <i style={`background:${t.vars['--bg-alt']}`} title="фон секций" />
                  <i style={`background:${t.vars['--fg']}`} title="текст" />
                  <i style={`background:${t.vars['--accent']}`} title="акцент" />
                </div>
                <p class="meta">Герой: {layoutNames[t.heroLayout]}</p>
                <span class="cta">Открыть вариант →</span>
              </div>
            </a>
          ))
        }
      </div>

      <h2>Референсы: реальные сайты фотографов в похожем стиле</h2>
      <div class="refs">
        {
          references.map((group) => (
            <div>
              <h3>{group.title}</h3>
              <ul>
                {group.sites.map((s) => (
                  <li>
                    <a href={s.url} target="_blank" rel="noopener">
                      {s.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="note">
        Все фотографии на сайте — временные заглушки (стоковые кадры без лиц). Как только появятся настоящие снимки, они
        подставляются в одном файле и появятся во всех вариантах сразу. Тексты, цены и контакты — тоже заглушки.
      </p>
    </div>
  </body>
</html>
